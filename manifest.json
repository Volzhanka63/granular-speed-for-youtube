{
  "manifest_version": 3,
  "name": "Granular Speed for YouTube",
  "version": "1.5.0",
  "description": "YouTube playback speed past 2x, in steps you choose. YouTube's own speed keys, a button in the player, Shorts support.",
  "homepage_url": "https://github.com/Volzhanka63/granular-speed-for-youtube",
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Granular Speed settings",
    "default_popup": "options.html?view=popup",
    "default_icon": {
      "48": "icons/48.png",
      "96": "icons/96.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "ui.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-granular-speed@personal.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "options.html"
      ],
      "matches": [
        "*://www.youtube.com/*"
      ]
    }
  ]
}
