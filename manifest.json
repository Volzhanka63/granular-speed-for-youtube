{
  "manifest_version": 3,
  "name": "Granular Speed for YouTube",
  "version": "1.3.0",
  "description": "YouTube playback speed in fine steps you choose, from 0.25x to 4x by default. Hotkeys, a player button and a settings page.",
  "homepage_url": "https://github.com/Volzhanka63/granular-speed-for-youtube",
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Granular Speed settings",
    "default_popup": "options.html",
    "default_icon": {
      "48": "icons/48.png",
      "96": "icons/96.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "ui.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-granular-speed@personal.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
